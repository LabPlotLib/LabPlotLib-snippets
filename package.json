{
  "name": "labplotlib-sidebar",
  "displayName": "LabPlotLib Sidebar",
  "icon": "media/labplotlib-logo-clear.png",
  "description": "Browse and insert LabPlotLib symbols and plotting calls.",
  "version": "0.1.6",
  "publisher": "labplotlib",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/labplotlib/labplotlib-snippets.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Snippets"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "main": "./src/extension.js",
  "activationEvents": ["onView:labplotlib.catalog"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "labplotlib",
          "title": "LabPlotLib",
          "icon": "media/labplotlib-logo-bw.png"
        }
      ]
    },
    "views": {
      "labplotlib": [
        {
          "type": "webview",
          "id": "labplotlib.catalog",
          "name": "Symbols and plots",
          "icon": "media/labplotlib-logo-clear.png"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
